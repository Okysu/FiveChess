{
  "name": "tianming-deckbuilder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && npm run check:ui && tsc --noEmit && npm run pack:atlas && npm run credits && vite build",
    "pack:atlas": "tsx scripts/pack-atlas.ts",
    "gen:sheets": "tsx scripts/art/sheets.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:ui && npm run audit && vitest run",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate-data.ts",
    "sim": "tsx scripts/simulate.ts",
    "gen:art": "tsx scripts/art/generate.ts",
    "export:tables": "tsx scripts/export-tables.ts",
    "check:ui": "tsx scripts/check-no-procedural.ts",
    "credits": "tsx scripts/credits.ts",
    "audio:import": "tsx scripts/audio/import-audio.ts",
    "audit": "tsx scripts/audit-reachability.ts --ci",
    "ui:tour": "tsx scripts/ui-tour.ts"
  },
  "dependencies": {
    "pixi.js": "^8.21.0",
    "yoga-layout": "^3.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.3",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "undici": "^8.11.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
