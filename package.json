{
  "name": "tianming-deckbuilder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate-data.ts",
    "sim": "tsx scripts/simulate.ts",
    "gen:art": "tsx scripts/art/generate.ts",
    "gen:sfx": "tsx scripts/audio/synth-sfx.ts",
    "export:tables": "tsx scripts/export-tables.ts"
  },
  "dependencies": {
    "pixi.js": "^8.21.0",
    "yoga-layout": "^3.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.3",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
