      {
        "hpBelow": 0.66,
        "name": "照见",
        "text": "你砍向我的每一刀，我都记得——因为握刀的，是你自己的手。",
        "atk": 15,
        "effects": [
          { "op": "summon", "unit": "e4_echo", "n": 2, "row": "front",
            "atk": { "max": [{ "count": "atk", "of": { "side": "enemy", "pick": "highestAtk" } }, 8] },
            "hp": { "max": [{ "count": "hp", "of": { "side": "enemy", "pick": "highestHp" } }, 24] } },
          { "op": "ward", "amount": 2, "target": "self" }
        ],
