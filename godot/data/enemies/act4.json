        "name": "焚书",
        "text": "若命书烧尽，便谁也不必再被写下……连我也是。",
        "atk": 18,
        "effects": [
          { "op": "summon", "unit": "e4_last_candle", "n": 3, "row": "back" },
          { "op": "status", "status": "might", "amount": 3, "target": "self" },
