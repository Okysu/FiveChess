; Engine configuration file.
; 命阙 — Godot 4.7 port: rules engine (engine/, parity-tested vs src/engine) + the game UI (core/, ui/, screens/, scenes/).
; See README.md.

config_version=5

[application]

config/name="命阙"
config/description="命阙 — 东方奇幻 Roguelike 卡牌构筑"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.043, 0.031, 0.024, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

Layout="*res://ui/layout.gd"
Assets="*res://core/assets.gd"
Session="*res://core/session.gd"
Audio="*res://core/audio.gd"
Router="*res://core/router.gd"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_global_identifier=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/confusable_local_declaration=0
gdscript/warnings/confusable_local_usage=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/redundant_await=0
gdscript/warnings/incompatible_ternary=0
gdscript/warnings/inference_on_variant=0
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/static_called_on_instance=0
gdscript/warnings/unreachable_code=0
gdscript/warnings/standalone_ternary=0
gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://fonts/NotoSerifSC-VF.ttf"
common/snap_controls_to_pixels=false

[importer_defaults]

texture={
"mipmaps/generate": true,
"compress/mode": 1,
"compress/lossy_quality": 0.9
}

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=2
environment/defaults/default_clear_color=Color(0.043, 0.031, 0.024, 1)
